<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- 本機建置的預設版號；正式版號由 GitHub Actions 以 -p:Version 帶入 -->
    <Version>0.0.0-dev</Version>
    <Product>BatteryCPUMonitor</Product>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- 除錯符號內嵌在執行檔裡，發布時只會有一個 exe -->
    <DebugType>embedded</DebugType>

    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- 免安裝完整版（發布時指定 self-contained）在執行檔裡留下記號，自動更新時才知道要下載哪一種 -->
  <ItemGroup Condition="'$(SelfContained)' == 'true'">
    <AssemblyMetadata Include="Variant" Value="standalone" />
  </ItemGroup>

  <ItemGroup>
    <!-- 同一個圖示也內嵌為資源，供系統匣使用 -->
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BatteryCPUMonitor.Tests" />
  </ItemGroup>

</Project>
